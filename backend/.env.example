APP_NAME=AgentMatrix
APP_VERSION=0.1.0
APP_ENV=development

# 默认只监听回环；如需局域网/跨机访问改为 0.0.0.0（会暴露全部接口）
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=true

LOG_LEVEL=INFO
LOG_FILE=logs/system.log

DATABASE_URL=sqlite:///./agentmatrix.db

OLLAMA_HOST=http://localhost:11434
# V4.4: 统一模型 — qwen2.5vl:7b 同时承担文本生成与视觉识别（无互斥切换）
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# 可选：按 Agent 分配模型（格式: agent_id:model_name,agent_id:model_name）
# 留空则所有 Agent 统一走主模型（8GB VRAM 下推荐留空以避免换页）
OLLAMA_AGENT_MODELS=

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 2026-09-22 佳文定版 / 2026-09-24 修正 id：云端统一 DeepSeek-V4.1-Flash。
# ★ API model id = deepseek-flash（"DeepSeek-V4.1-Flash" 是网关显示名，传显示名 400）。
#   所有云端增强/兜底/视觉调用均读此字段。旧值 deepseek-v4-pro 已弃用。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# V3.5: Web Search 插件（地点/美食/天气/旅行/评价等时效性问题）
DEEPSEEK_SEARCH_ENABLED=true
# 时效性知识库 TTL（天）：过期后再次提问触发 web search 刷新
TIMELY_KNOWLEDGE_TTL_DAYS=30

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

COMPLEXITY_THRESHOLD=0.65

MAX_CONCURRENT_TASKS=10
MAX_RETRY_ATTEMPTS=3

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── P0: 本地 API 鉴权 ──
# 开启后所有 /api/** 与 /ws 需携带 Authorization: Bearer <token>
# （WebSocket 用 ?token=）。令牌自动生成并写入 backend/.token（打包后为
# %APPDATA%/AgentMatrix/.token），无需手工填写。
AUTH_ENABLED=true
# 开发环境专供浏览器直连 next dev 取令牌（仅回环来源）；打包后不生效
ALLOW_DEV_TOKEN_ENDPOINT=true